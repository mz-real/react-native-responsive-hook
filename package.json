{
  "name": "react-native-responsive-hook",
  "version": "1.5.0",
  "license": "MIT",
  "description": "Responsive React Native hooks: breakpoints, select(), accessible font scaling, wp/hp and moderate scale that update on rotation. TypeScript, Expo and web ready.",
  "main": "./lib/commonjs/index.js",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "bob build",
    "prepare": "bob build",
    "lint:package": "publint && attw --pack .",
    "test:types-compat": "rm -f react-native-responsive-hook-*.tgz && npm pack --silent >/dev/null && cd test/types-compat && npm install --no-audit --no-fund --ignore-scripts && npm install --no-save --no-audit --no-fund --ignore-scripts ../../react-native-responsive-hook-*.tgz && tsc -p tsconfig.json && tsc -p tsconfig.strict.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mz-real/react-native-responsive-hook.git"
  },
  "keywords": [
    "react-native",
    "responsive",
    "responsive-ui",
    "responsive-design",
    "breakpoints",
    "hooks",
    "useResponsive",
    "font-scaling",
    "accessibility",
    "expo",
    "responsive-screen",
    "size-matters",
    "scale",
    "moderate-scale",
    "widthPercentageToDP",
    "heightPercentageToDP",
    "orientation",
    "tablet",
    "react-native-web",
    "typescript"
  ],
  "homepage": "https://github.com/mz-real/react-native-responsive-hook#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.61"
  },
  "types": "./lib/typescript/commonjs/index.d.ts",
  "bugs": {
    "url": "https://github.com/mz-real/react-native-responsive-hook/issues"
  },
  "author": "Muhammad Zakria",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-builder-bob": "^0.40.18",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "module": "./lib/module/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
